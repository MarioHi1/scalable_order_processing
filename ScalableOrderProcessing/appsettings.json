{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Npgsql": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "MockApi": {
    "BaseAddress": "https://mockapi-ms5j.onrender.com/",
    "TimeoutSeconds": 90
  },
  "Worker": {
    "PollIntervalSeconds": 10,
    "MaxQueueSize": 20,
    "MaxParallelJobs": 5,
    "JobTimeoutMinutes": 5
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5434;Database=orders;Username=postgres;Password=postgres"
  }
}